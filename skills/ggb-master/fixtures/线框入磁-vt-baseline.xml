	</kernel>
	<tableview min="-2.0" max="2.0" step="1.0" />
	<scripting blocked="false" disabled="false" />
	<construction title="线框入磁v-t图像" author="" date="">
		<!-- ============ 1. 物理参数滑杆（教师层：一个物理量一个滑杆） ============ -->
		<element type="numeric" label="B">
	<value val="0.8"/>
	<slider min="0.5" max="1.0" width="140" x="490" y="8" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="磁感应强度 B (T)"/>
</element>
		<element type="numeric" label="l">
	<value val="0.35"/>
	<slider min="0.25" max="0.45" width="140" x="650" y="8" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="底边 ab 长 (m)"/>
</element>
		<element type="numeric" label="H">
	<value val="0.6"/>
	<slider min="0.3" max="0.8" width="140" x="810" y="8" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="线框高度 d (m)"/>
</element>
		<element type="numeric" label="m">
	<value val="0.05"/>
	<slider min="0.03" max="0.10" width="140" x="20" y="52" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="线框质量 (kg)"/>
</element>
		<element type="numeric" label="R">
	<value val="0.25"/>
	<slider min="0.15" max="0.45" width="140" x="180" y="52" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="线框电阻 (Ω)"/>
</element>
		<element type="numeric" label="g">
	<value val="9.8"/>
	<slider min="5" max="15" width="140" x="340" y="52" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="重力加速度 g (m/s²)"/>
</element>
		<element type="numeric" label="k">
	<value val="1.5"/>
	<slider min="0.3" max="2.2" width="280" x="20" y="8" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1" type="1" playing="false" />
	<caption val="进入速度比 k = v₁/v_C（观众主控）"/>
</element>
		<!-- ============ 2. 派生物理量（解析闭式） ============ -->
		<expression label="vC" exp="m*g*R/(B^2*l^2)" type="numeric" />
		<element type="numeric" label="vC">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="1.5625" />
			<caption val="临界速度 mgR/(B²l²)" />
		</element>
		<expression label="v1" exp="k*vC" type="numeric" />
		<element type="numeric" label="v1">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="2.34375" />
			<caption val="进入磁场时速度" />
		</element>
		<expression label="t1" exp="v1/g" type="numeric" />
		<element type="numeric" label="t1">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="0.23915816326530612" />
			<caption val="ab 边刚进入磁场时刻" />
		</element>
		<expression label="h" exp="v1*t1/2" type="numeric" />
		<element type="numeric" label="h">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="0.2802634725765306" />
			<caption val="释放高度（ab 边到磁场边界距离）" />
		</element>
		<expression label="K" exp="g/vC" type="numeric" />
		<element type="numeric" label="K">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="6.272" />
			<caption val="阻尼速率常数 g/v_C" />
		</element>
		<!-- ============ 3. NSolveODE 数值解：进入过程 v(x) 与 τ(x)（x=进入距离） ============ -->
		<expression label="v'" exp="v'(x, v, w) = g/v - K" type="function" />
		<element type="functionnvar" label="v'">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
		</element>
		<expression label="tau'" exp="tau'(x, v, w) = 1/v" type="function" />
		<element type="functionnvar" label="tau'">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
		</element>
		<command name="NSolveODE">
			<input a0="{v', tau'}" a1="0" a2="{v1, 0}" a3="H" />
			<output a0="nv" a1="nt" />
		</command>
		<element type="locus" label="nv">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
		</element>
		<element type="locus" label="nt">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
		</element>
		<command name="Point">
			<input a0="nv" a1="1" />
			<output a0="P_v2" />
		</command>
		<element type="point" label="P_v2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<pointSize val="3" />
			<pointStyle val="0" />
			<coords x="0.6" y="1.6706208777116553" z="1.0" />
		</element>
		<command name="Point">
			<input a0="nt" a1="1" />
			<output a0="P_t2" />
		</command>
		<element type="point" label="P_t2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<pointSize val="3" />
			<pointStyle val="0" />
			<coords x="0.6" y="0.31531335486853634" z="1.0" />
		</element>
		<expression label="v2" exp="y(P_v2)" type="numeric" />
		<element type="numeric" label="v2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="1.6706208777116553" />
			<caption val="cd 边刚进入磁场时速度" />
		</element>
		<expression label="td" exp="y(P_t2)" type="numeric" />
		<element type="numeric" label="td">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="0.31531335486853634" />
			<caption val="进入过程时长 Δ" />
		</element>
		<expression label="t2" exp="t1 + td" type="numeric" />
		<element type="numeric" label="t2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="0.5544715181338424" />
			<caption val="cd 边刚进入磁场时刻" />
		</element>
		<expression label="tEnd" exp="t2 + 0.5" type="numeric" />
		<element type="numeric" label="tEnd">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="1.0544715181338424" />
			<caption val="演示终点时刻（完全进入+尾段 0.5s）" />
		</element>
		<expression label="vTail" exp="v2 + 0.5*g" type="numeric" />
		<element type="numeric" label="vTail">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="6.570620877711656" />
			<caption val="尾段末速度" />
		</element>
		<expression label="tRange" exp="(tEnd + 0.1)*1.25" type="numeric" />
		<element type="numeric" label="tRange">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0.0" />
			<layer val="0" />
			<labelMode val="0" />
			<value val="1.4430893976673032" />
			<caption val="v-t 图横轴范围" />
		</element>
		<!-- ============ 4. 主时钟滑杆（动态上限 tEnd，播完自停） ============ -->
		<element type="numeric" label="t">
	<value val="0"/>
	<slider min="0" max="tEnd" width="150" x="320" y="8" absoluteScreenLocation="true" fixed="false" horizontal="true" showAlgebra="true" />
	<lineStyle thickness="10" type="0" typeHidden="1"/>
	<show object="true" label="true" ev="4"/>
	<objColor r="0" g="0" b="0" alpha="0.0"/>
	<layer val="0"/>
	<labelMode val="1"/>
	<animation speed="1.2" type="3" playing="false" />
	<caption val="时间 t（动画主时钟）"/>
	<ggbscript onUpdate="If[t &gt;= tEnd, SetCaption[btnPlay, &quot;播放 ▶&quot;]]"/>
</element>
		<!-- ============ 5. 运动学函数（解析分段闭式） ============ -->
		<expression label="fv" exp="fv(x) = If[x &lt; t1, g*x, If[x &lt;= t2, vC + (v1 - vC)*exp(-K*(x - t1)), v2 + g*(x - t2)]]" type="function" />
		<element type="function" label="fv">
			<show object="false" label="false" ev="4" />
			<objColor r="204" g="51" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<fixed val="true" />
		</element>
		<expression label="fs" exp="fs(x) = If[x &lt; t1, 0.5*g*x^2, If[x &lt;= t2, h + vC*(x - t1) + (v1 - vC)*(1 - exp(-K*(x - t1)))/K, h + H + v2*(x - t2) + 0.5*g*(x - t2)^2]]" type="function" />
		<element type="function" label="fs">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<fixed val="true" />
		</element>
		<!-- ============ 6. 动画区：磁场边界 / × 点阵 / 线框 / 速度矢量 ============ -->
		<expression label="O1" exp="(-1.25, 0)" type="point" />
		<element type="point" label="O1">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<pointSize val="3" />
			<pointStyle val="0" />
			<coords x="-1.25" y="0" />
		</element>
		<expression label="O2" exp="(0.85, 0)" type="point" />
		<element type="point" label="O2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<pointSize val="3" />
			<pointStyle val="0" />
			<coords x="0.85" y="0" />
		</element>
		<command name="Segment">
			<input a0="O1" a1="O2" />
			<output a0="boundary" />
		</command>
		<element type="segment" label="boundary">
			<show object="true" label="false" ev="4" />
			<objColor r="0" g="0" b="0" alpha="0" />
			<layer val="0" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" />
		</element>
		<!-- 线框顶点（追随 fs(t)，a=左下 b=右下 c=右上 d=左上） -->
		<expression label="a" exp="(-0.2 - l/2, h - fs(t))" type="point" />
		<element type="point" label="a">
			<show object="true" label="true" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="2" />
			<labelMode val="0" />
			<pointSize val="2" />
			<pointStyle val="0" />
			<coords x="-0.375" y="0.2802634725765306" z="1.0" />
		</element>
		<expression label="b" exp="(-0.2 + l/2, h - fs(t))" type="point" />
		<element type="point" label="b">
			<show object="true" label="true" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="2" />
			<labelMode val="0" />
			<pointSize val="2" />
			<pointStyle val="0" />
			<coords x="-0.025" y="0.2802634725765306" z="1.0" />
		</element>
		<expression label="c" exp="(-0.2 + l/2, h - fs(t) + H)" type="point" />
		<element type="point" label="c">
			<show object="true" label="true" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="2" />
			<labelMode val="0" />
			<pointSize val="2" />
			<pointStyle val="0" />
			<coords x="-0.025" y="0.8802634725765306" z="1.0" />
		</element>
		<expression label="d" exp="(-0.2 - l/2, h - fs(t) + H)" type="point" />
		<element type="point" label="d">
			<show object="true" label="true" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="2" />
			<labelMode val="0" />
			<pointSize val="2" />
			<pointStyle val="0" />
			<coords x="-0.375" y="0.8802634725765306" z="1.0" />
		</element>
		<command name="Polygon">
			<input a0="a" a1="b" a2="c" a3="d" />
			<output a0="wire" a1="se1" a2="se2" a3="se3" a4="se4" />
		</command>
		<element type="polygon" label="wire">
			<show object="true" label="false" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0.15" />
			<layer val="1" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" opacity="255" />
		</element>
		<element type="segment" label="se1">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="1" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" />
		</element>
		<element type="segment" label="se2">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="1" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" />
		</element>
		<element type="segment" label="se3">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="1" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" />
		</element>
		<element type="segment" label="se4">
			<show object="false" label="false" ev="4" />
			<objColor r="0" g="0" b="255" alpha="0" />
			<layer val="1" />
			<labelMode val="0" />
			<lineStyle thickness="3" type="0" typeHidden="1" />
		</element>
		<!-- 速度矢量（线框中心，红色箭头，长度正比于 fv(t)） -->
		<expression label="M0" exp="(-0.2, h - fs(t) + H/2)" type="point" />
		<element type="point" label="M0">
			<show object="false" label="false" ev="4" />
